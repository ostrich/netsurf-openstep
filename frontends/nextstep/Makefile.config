# Cross-build settings. The host recipe supplies NEXTSTEP_CC and dependency paths.
override CC := $(NEXTSTEP_CC)
override OBJC_CC := $(NEXTSTEP_CC)
override LINK_CC := $(NEXTSTEP_CC)
override BUILD_CC := cc
override CCACHE :=
override CC_CAN_BUILD_AND_DEP := no
override CC_CANNOT_DEP := yes
CFLAGS += -DNETSURF_NEXTSTEP -DNO_IPV6 -std=gnu99 -O2 -include frontends/nextstep/c-prefix.h
# GCC may fuse sin/cos into cexp, or narrow ceil to missing ceilf. Keep -O2,
# but preserve calls to the math routines actually provided by libsys_s.
CFLAGS += -fno-builtin-sin -fno-builtin-cos -fno-builtin-ceil
CFLAGS += $(NEXTSTEP_DEP_CFLAGS)
LDFLAGS += $(NEXTSTEP_DEP_LDFLAGS)
COMMON_WARNFLAGS += -Wno-unused-parameter -Wno-redundant-decls
NETSURF_USE_CURL := YES
NETSURF_USE_OPENSSL := YES
NETSURF_USE_GIF := YES
NETSURF_USE_JPEG := YES
NETSURF_USE_NSLOG := YES
NETSURF_USE_UTF8PROC := YES
NETSURF_USE_BMP := YES
NETSURF_USE_JPEGXL := NO
NETSURF_USE_PNG := YES
NETSURF_USE_VIDEO := NO
NETSURF_USE_WEBP := NO
NETSURF_USE_HARU_PDF := NO
NETSURF_USE_NSPSL := NO
NETSURF_USE_NSSVG := YES
NETSURF_USE_ROSPRITE := NO
NETSURF_USE_RSVG := NO
NETSURF_USE_DUKTAPE := YES
NETSURF_USE_LIBICONV_PLUG := NO
NETSURF_STRIP_BINARY := NO
